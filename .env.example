# =============================================================================
# Copy this file to `.env` (same folder), then fill real values.
# `.env` is gitignored — each teammate must create their own. Never commit secrets.
# =============================================================================

# Supabase Dashboard → Project Settings → API
# Use the cloud project URL, NOT http://localhost:54321
# (localhost is only for `supabase start` local stack, which this team is not using by default)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# There is NO VITE_DEMO_MODE in the current app.
# If your .env still has demo-mode / localhost:54321, replace it with the real cloud values above.

# GLM key must NOT go in Vite env (no VITE_ prefix for secrets).
# Agent chat: set as Supabase Edge Function secrets:
#   GLM_API_KEY=your-zhipu-key
#   GLM_MODEL=glm-5.2   (optional; default in Edge Function)
#
# Local scripts only (npm run bili:summarize / bili:import) — can use a *different* key:
# GLM_SUMMARY_API_KEY=your-zhipu-summary-key
# GLM_SUMMARY_MODEL=glm-4-flash
#
# Batch import writes to Supabase directly (bypasses RLS). Use service_role, NEVER expose as VITE_:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
